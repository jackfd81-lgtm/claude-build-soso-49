{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"MUSE0301CRAMPUCommittedTransition",
  "type":"object",
  "required":["txid","block_id","revision","agent_id","action","record_sha256","committed_ns"],
  "properties":{
    "txid":{"type":"string","pattern":"^[a-f0-9]{32}$"},
