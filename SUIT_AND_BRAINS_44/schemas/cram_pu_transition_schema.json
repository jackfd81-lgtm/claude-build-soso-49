    "agent_id":{"type":"string","minLength":1},
    "action":{"const":"COMMIT"},
    "record_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "committed_ns":{"type":"integer","minimum":0}
  },
  "additionalProperties":false
}
