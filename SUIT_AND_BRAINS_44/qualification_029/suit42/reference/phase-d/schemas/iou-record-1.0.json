{"$defs":{"dualDigest":{"additionalProperties":false,"properties":{"blake2b256":{"pattern":"^blake2b256:[0-9a-f]{64}$","type":"string"},"sha256":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"}},"required":["blake2b256","sha256"],"type":"object"},"iouId":{"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$","type":"string"}},"$id":"https://ph6.soso-suit/4.0.0/schemas/iou-record-1.0.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Immutable IOU record. Every lifecycle transition produces a new record with one appended history event; RESOLVED and ABANDONED are terminal. Structural schema only; the engine enforces the transition matrix.","properties":{"block_reason":{"anyOf":[{"type":"string"},{"type":"null"}]},"blocking":{"type":"boolean"},"code":{"anyOf":[{"enum":["IOU_UNMAPPED_OBSERVATION","IOU_MISSING_DISCRIMINATOR","IOU_SOURCE_UNAVAILABLE","IOU_AMBIGUOUS_READING"]},{"type":"null"}]},"conflicts":{"items":{"$ref":"#/$defs/iouId"},"type":"array"},"creator":{"type":"string"},"description":{"type":"string"},"history":{"items":{"additionalProperties":false,"properties":{"actor":{"type":"string"},"detail":{"type":"string"},"event":{"enum":["CREATED","STARTED","BLOCKED","UNBLOCKED","RESOLVED","ABANDONED","TRANSFERRED","CONFLICT_DETECTED","CONFLICT_RESOLVED"]},"role":{"enum":["CREATOR","RESOLVER","BLOCKER","OWNER","OBSERVER","ADMIN"]},"seq":{"type":"integer"}},"required":["seq","event","actor","role","detail"],"type":"object"},"type":"array"},"iou_id":{"$ref":"#/$defs/iouId"},"iou_type":{"enum":["READING","QUESTION","REQUEST","PERMISSION","CONFIRMATION"]},"owner":{"type":"string"},"parameters_hash":{"anyOf":[{"$ref":"#/$defs/dualDigest"},{"type":"null"}]},"priority":{"type":"integer"},"record_digest":{"$ref":"#/$defs/dualDigest"},"record_version":{"const":"iou-record/1.0"},"resolution_path":{"anyOf":[{"type":"string"},{"type":"null"}]},"resolution_summary":{"anyOf":[{"type":"string"},{"type":"null"}]},"resource":{"any