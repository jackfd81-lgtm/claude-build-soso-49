{"$defs":{"intId":{"pattern":"^int:[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$","type":"string"}},"$id":"https://ph6.soso-suit/4.0.0/schemas/internal-provenance-graph-1.0.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"The AI's declared internal dependency graph. Every node id MUST use the int: namespace; ext: is reserved for committed external provenance. Structural schema only; the validator establishes the claimed dependency path, never semantic proof.","properties":{"edges":{"items":{"additionalProperties":false,"properties":{"edge_type":{"enum":["int:supports","int:raises","int:requests"]},"from_id":{"$ref":"#/$defs/intId"},"to_id":{"$ref":"#/$defs/intId"}},"required":["from_id","to_id","edge_type"],"type":"object"},"type":"array"},"graph_version":{"const":"internal-provenance/1.0"},"nodes":{"items":{"additionalProperties":false,"properties":{"node_id":{"$ref":"#/$defs/intId"},"node_type":{"enum":["int:observation","int:interpretation","int:iou","int:action"]},"payload":{"type":"object"}},"required":["node_id","node_type","payload"],"type":"object"},"type":"array"}},"required":["graph_version","nodes","edges"],"title":"InternalProvenanceGraph","type":"object"}