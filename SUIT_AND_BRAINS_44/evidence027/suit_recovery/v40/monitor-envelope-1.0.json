{"$defs": {"dualDigest": {"additionalProperties": false, "properties": {"blake2b256": {"pattern": "^blake2b256:[0-9a-f]{64}$", "type": "string"}, "sha256": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}}, "required": ["blake2b256", "sha256"], "type": "object"}}, "$id": "https://ph6.soso-suit/4.0.0/schemas/monitor-envelope-1.0.json", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "description": "The monitor's deterministic admissibility verdict. producer MUST be MONITOR.", "properties": {"candidate_digest": {"$ref": "#/$defs/dualDigest"}, "committed_monitor_build_hash": {"$ref": "#/$defs/dualDigest"}, "envelope_digest": {"$ref": "#/$defs/dualDigest"}, "envelope_version": {"const": "monitor-envelope/1.0"}, "evaluator_build_hash": {"$ref": "#/$defs/dualDigest"}, "governed_state_digest": {"$ref": "#/$defs/dualDigest"}, "producer": {"const": "MONITOR"}, "reasons": {"items": {"enum": ["SCHEMA_VIOLATION", "PRODUCER_MISMATCH", "STATE_BINDING_MISMATCH", "MONITOR_BUILD_MISMATCH", "UNREGISTERED_CODE", "ACTION_NOT_ALLOWED", "EVIDENCE_UNRESOLVED", "DANGLING_REFERENCE", "EXT_NAMESPACE_VIOLATION", "RESOURCE_EXCEEDED", "DUPLICATE_ID", "PROVENANCE_SCHEMA_VIOLATION", "PROVENANCE_DANGLING_REF", "PROVENANCE_CYCLE", "PROVENANCE_UNBOUNDED", "PROVENANCE_ROOT_UNREACHABLE", "NON_ADVISORY_ACTION"], "type": "string"}, "type": "array"}, "verdict": {"enum": ["ACCEPTED_AS_ADVISORY", "REJECT"]}, "work_units_consumed": {"minimum": 0, "type": "integer"}}, "required": ["envelope_version", "producer", "governed_state_digest", "candidate_digest", "evaluator_build_hash", "committed_monitor_build_hash", "verdict", "reasons", "work_units_consumed", "envelope_digest"], "title": "MonitorEnvelope", "type": "object"}