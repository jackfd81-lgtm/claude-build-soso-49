{"$defs": {"dualDigest": {"additionalProperties": false, "properties": {"blake2b256": {"pattern": "^blake2b256:[0-9a-f]{64}$", "type": "string"}, "sha256": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}}, "required": ["blake2b256", "sha256"], "type": "object"}}, "$id": "https://ph6.soso-suit/4.0.0/schemas/disposition-record-1.0.json", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "description": "The normalizer's downstream-consumable outcome record. producer MUST be NORMALIZER. Binds the full chain: governed state -> candidate -> envelope -> record.", "properties": {"candidate_digest": {"$ref": "#/$defs/dualDigest"}, "envelope_digest": {"$ref": "#/$defs/dualDigest"}, "governed_state_digest": {"$ref": "#/$defs/dualDigest"}, "normalizer_build_hash": {"$ref": "#/$defs/dualDigest"}, "producer": {"const": "NORMALIZER"}, "reasons": {"items": {"enum": ["SCHEMA_VIOLATION", "PRODUCER_MISMATCH", "STATE_BINDING_MISMATCH", "MONITOR_BUILD_MISMATCH", "UNREGISTERED_CODE", "ACTION_NOT_ALLOWED", "EVIDENCE_UNRESOLVED", "DANGLING_REFERENCE", "EXT_NAMESPACE_VIOLATION", "RESOURCE_EXCEEDED", "DUPLICATE_ID", "PROVENANCE_SCHEMA_VIOLATION", "PROVENANCE_DANGLING_REF", "PROVENANCE_CYCLE", "PROVENANCE_UNBOUNDED", "PROVENANCE_ROOT_UNREACHABLE", "NON_ADVISORY_ACTION"], "type": "string"}, "type": "array"}, "record_digest": {"$ref": "#/$defs/dualDigest"}, "record_version": {"const": "disposition-record/1.0"}, "verdict": {"enum": ["ACCEPTED_AS_ADVISORY", "REJECT"]}}, "required": ["record_version", "producer", "normalizer_build_hash", "governed_state_digest", "candidate_digest", "envelope_digest", "verdict", "reasons", "record_digest"], "title": "DispositionRecord", "type": "object"}